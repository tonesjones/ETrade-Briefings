# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# --- E*TRADE ---
ETRADE_CONSUMER_KEY=your_consumer_key_here
ETRADE_CONSUMER_SECRET=your_consumer_secret_here

# true = Sandbox, false = Production
ETRADE_DEV=false

# Daily access tokens. `python etrade_auth.py` writes these two keys in place.
# Tokens expire at midnight US Eastern — re-run that script after expiry.
# Do not paste token values by hand.
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_TOKEN_SECRET=

# Optional: limit to one account. Leave unset to pull ALL active accounts.
# ETRADE_ACCOUNT_ID_KEY=
