# Copy this file to .env and fill in your real values
# NEVER commit .env to git

# --- E*TRADE ---
ETRADE_CONSUMER_KEY=your_consumer_key_here
ETRADE_CONSUMER_SECRET=your_consumer_secret_here

# true = Sandbox, false = Production
ETRADE_DEV=false

# Access tokens from etrade_auth.py — expire at midnight US Eastern daily.
# Re-run etrade_auth.py (browser + code) after each midnight ET and replace these.
ETRADE_ACCESS_TOKEN=
ETRADE_ACCESS_TOKEN_SECRET=

# Optional: limit to one account. Leave unset to pull ALL active accounts.
# ETRADE_ACCOUNT_ID_KEY=

# Employer SNPS sleeve mark (used in build_briefing_prompt.py full analysis)
# SNPS_MARKET_VALUE=60000
# Optional: currently tradable $ (restricted/unvested remainder is not assumed saleable)
# SNPS_TRADABLE_VALUE=20000
# SNPS_RESTRICTIONS=RSU blackout; 10b5-1 only

# --- xAI API (optional — only if you use run_daily_briefing.py) ---
# Not needed for the recommended flow: get_portfolio.py → paste into grok.com
# XAI_API_KEY=xai-your_key_here
# XAI_MODEL=grok-4.5
